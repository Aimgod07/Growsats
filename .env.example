VITE_API_BASE_URL=https://67c7374cbb0988d092ea.appwrite.global
VITE_BACKEND_URL=http://localhost:8787

# Pins a specific Turnstile widget for this build. Leave empty to let the
# backend advertise its own widget via GET /api/config — that keeps the client
# from drifting away from the secret the server verifies against.
# Create one with: npx wrangler turnstile widget create Playloot --domain playloot.pages.dev --domain localhost
VITE_TURNSTILE_SITE_KEY=

# --- server/index.js (the legacy Node API, port 8788) ----------------------
# Loaded via `node --env-file=.env` (see `npm run dev:legacy-api`).
# Public; the browser widget uses the same value.
# TURNSTILE_SITE_KEY=0x4AAAAAAFXmATbXG4Sg1k1s
# Verifies the tokens sent as `turnstileToken` on /api/auth/login and
# /api/auth/register. Fetch with:
#   npx wrangler turnstile widget get 0x4AAAAAAFXmATbXG4Sg1k1s --json
# Cloudflare's always-pass test secret is 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Set to "off" to skip verification during local development.
# TURNSTILE_ENFORCE=off
# Only accept tokens minted for these hostnames.
# TURNSTILE_HOSTNAMES=localhost,playloot.pages.dev
# PORT=8788