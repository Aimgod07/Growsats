{
    "name": "growsats",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:worker": "wrangler dev --local --port 8788",
        "dev:legacy-api": "node --env-file=.env server/index.js --port 8788",
        "test:legacy-api": "node --test server/*.test.js",
        "verify:turnstile": "node server/verify-turnstile-live.mjs",
        "db:migrate:local": "wrangler d1 migrations apply playloot-prod-db --local",
        "db:migrate:remote": "wrangler d1 migrations apply playloot-prod-db --remote",
        "deploy:api": "wrangler deploy",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "deadcode": "node scripts/deadcode.mjs",
        "deploy:pages": "npm run build && wrangler pages deploy dist --project-name playloot --branch main",
        "pages:dev": "wrangler pages dev dist"
    },
    "dependencies": {
        "@capacitor/android": "^8.4.2",
        "@capacitor/core": "^8.4.2",
        "@capacitor/local-notifications": "^8.3.1",
        "@capacitor/push-notifications": "^8.1.3",
        "@fontsource-variable/inter": "^5.3.0",
        "@google/model-viewer": "^4.4.0",
        "@tailwindcss/vite": "^4.3.2",
        "lucide-react": "^1.26.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.1",
        "tailwindcss": "^4.3.2"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.4.2",
        "@eslint/js": "^10.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "jsdom": "^25.0.1",
        "vite": "^8.1.1",
        "vitest": "^5.0.5",
        "wrangler": "^4.149.0"
    }
}
