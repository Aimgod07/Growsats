{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playloot-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playloot-prod-db",
      "database_id": "f92efe11-1eef-4190-ac74-51121ab51e66",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "playloot-prod-files" }
  ]
}
