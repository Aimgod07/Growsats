VITE_BACKEND_URL=http://localhost:8787

# Turnstile site key. Leave blank to read it from GET /api/config on the
# backend, which is the default and keeps both sides in sync automatically.
# Set it only to pin a specific widget, e.g. Cloudflare's always-pass test key:
#   VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFTEa3N6LEK_EQ-j
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFXmATbXG4Sg1k1s